# Camada de mocks (MSW + Socket.IO simulado). true em dev, demonstração publicada e testes.
VITE_ENABLE_MOCKS=true
# Perfil de latência padrão dos mocks: none | fast | slow | variable
VITE_MOCK_LATENCY=fast
# Endpoint (simulado) do Socket.IO
VITE_SOCKET_URL=wss://realtime.kurio.mock
# Timeout das requisições REST (ms)
VITE_HTTP_TIMEOUT_MS=10000
